# ESP-Brookesia Learning Project - Default Configuration
# Based on Speaker product configuration

# ====================================
# ESP-IDF SDK Configuration
# ====================================

# ESP32-S3 specific configuration
CONFIG_IDF_TARGET_ESP32S3=y

# CPU Frequency
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y

# ====================================
# ESP-Brookesia Core Configuration
# ====================================

# Enable Systems
CONFIG_ESP_BROOKESIA_ENABLE_SYSTEMS=y
CONFIG_ESP_BROOKESIA_SYSTEMS_ENABLE_BASE=y

# Enable GUI
CONFIG_ESP_BROOKESIA_ENABLE_GUI=y

# Enable Services
CONFIG_ESP_BROOKESIA_ENABLE_SERVICES=y
CONFIG_ESP_BROOKESIA_SERVICES_ENABLE_STORAGE_NVS=y

# Disable AI Framework for Lesson 1
CONFIG_ESP_BROOKESIA_ENABLE_AI_FRAMEWORK=n

# ====================================
# LVGL Configuration
# ====================================

# LVGL version 9
CONFIG_LV_LVGL_H_INCLUDE_SIMPLE=y

# Color depth
CONFIG_LV_COLOR_DEPTH_16=y

# Screen size
CONFIG_LV_HOR_RES_MAX=360
CONFIG_LV_VER_RES_MAX=360

# Enable LVGL built-in styles
CONFIG_LV_USE_STYLE_GEN=y

# ====================================
# Memory Configuration
# ====================================

# Memory allocation
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_USE_CAPS_ALLOC=y
CONFIG_SPIRAM_USE_MALLOC_ALWAYSINTERNAL=16384

# ====================================
# Log Configuration
# ====================================

# Log level for ESP-Brookesia
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# Enable debug logs for learning
CONFIG_ESP_BROOKESIA_ENABLE_DEBUG_LOG=y
